OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
FALKORDB_URL=redis://127.0.0.1:17379
SESSION_SECRET=replace-with-a-random-32-byte-secret
AGENT_RUNTIME_URL=http://127.0.0.1:3010
AGENT_PRODUCER_URL=http://127.0.0.1:3011
PACT_AGENT_TRANSPORT=eve
PACT_RUNTIME_TOKEN=replace-with-a-separate-random-32-byte-secret
