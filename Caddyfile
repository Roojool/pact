{$PACT_DOMAIN:localhost} {
  encode zstd gzip

  # Self-hosted demo media: /media/* -> /srv/pact-media (release assets, not in git)
  handle_path /media/* {
    root * /srv/pact-media
    file_server
  }

  # Self-hosted demo watchpage: exact /demo and /demo/ -> /srv/pact-demo/index.html
  handle /demo {
    rewrite * /index.html
    root * /srv/pact-demo
    file_server
  }
  handle /demo/ {
    rewrite * /index.html
    root * /srv/pact-demo
    file_server
  }

  # Fallback: the Next.js app
  handle {
    reverse_proxy web:3000 {
      flush_interval -1
    }
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
}
