# ==============================================================================
# PACT Production Environment Configuration Template
# Recommended production location: /etc/pact/pact.env
# Secure file permissions required: chmod 600 /etc/pact/pact.env
# ==============================================================================

# REQUIRED: Random 32+ byte hex string used for signing HMAC workspace session cookies
# Generate via: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED: Shared bearer authorization token for web <-> agent-runtime communication
# Generate via: openssl rand -hex 32
PACT_RUNTIME_TOKEN=

# OPTIONAL: Public hostname, domain, or IP for Caddy reverse proxy
# Default: localhost
# Set to your domain (e.g., pact.example.com) for automatic Let's Encrypt TLS
# Or set to ':80' for plain HTTP on an IP address
PACT_DOMAIN=localhost

# OPTIONAL: OpenAI API Key for live LLM reasoning in agent runtimes
# Leave blank to run in deterministic, offline, graph-grounded mode ($0 spend)
OPENAI_API_KEY=

# OPTIONAL: Model identifier (default: gpt-6.1-sol)
OPENAI_MODEL=gpt-6.1-sol

# OPTIONAL: Global spend cap in USD enforced by durable Redis ledger (default: 5)
PACT_API_BUDGET_USD=5

# OPTIONAL: Graph namespace identifiers
PACT_AGENT_GRAPH=pact_agent
PACT_BUDGET_GRAPH=pact_budget
